# Cổng chạy Express (dev + production)
PORT=3000

# URL công khai của app (dùng cho link tự tham chiếu)
APP_URL="http://localhost:3000"

# Khóa API Google Gemini — chỉ đặt ở server, không commit
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Cloudflare Workers: đặt secret bằng `wrangler secret put`, không dùng tệp này
# GEMINI_API_KEY, ACCESS_CODE, SESSION_SECRET
