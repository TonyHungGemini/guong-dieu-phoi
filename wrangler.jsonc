{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guong-dieu-phoi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SYNC_KV",
      "id": "03bb6377433f4fe998c84cb9d5d4fcc2"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GEMINI_RELAY", "class_name": "GeminiRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeminiRelay"] }],
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "GEMINI_THINKING_LEVEL": "LOW",
    "GOOGLE_CLIENT_ID": "80167301652-dpfgs2regia45ul3nij8klfrchbpe4gj.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
